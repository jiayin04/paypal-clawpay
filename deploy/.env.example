# Deployment settings, not application credentials. Copy to deploy/.env.
# Build/load this image off the VPS, or set an immutable registry image tag.
CLAWPAY_BACKEND_IMAGE=clawpay-backend:local
CLAWPAY_API_PORT=18000
CLAWPAY_AGENT_PORT=18201
# Used only by the optional ingress profile. Use your own API hostname.
CLAWPAY_API_HOST=api.example.com
