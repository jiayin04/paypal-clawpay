{
  "name": "clawpay-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-worker.mjs",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/app.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:ui": "node scripts/verify-ui.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@supabase/supabase-js": "^2.99.0",
    "hono": "^4.12.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
