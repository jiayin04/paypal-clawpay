# ClawPay middleware environment template.
# Copy to .env for local development. NEVER commit .env or real credentials.
# SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET, PAYPAL_CLIENT_SECRET,
# INTERNAL_SERVICE_TOKEN, DEVICE_TOKEN_PEPPER and LLM_PROXY_UPSTREAM_API_KEY are
# server-side only: never put them in the dashboard, public frontend variables,
# or ESP32 firmware.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# text (default, human-readable) or json (one object per line with request_id,
# device_id, user_id, order_id) for shipping logs to Loki/Datadog/CloudWatch.
LOG_FORMAT=text
# Bearer token for GET /metrics (Prometheus text format). Empty = endpoint
# disabled (404). At least 32 characters; generate like INTERNAL_SERVICE_TOKEN.
METRICS_TOKEN=

SUPABASE_URL=
# Publishable key (sb_publishable_...) for RLS-scoped dashboard reads.
# SUPABASE_ANON_KEY is accepted as a legacy alias; PUBLISHABLE wins if both are set.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for legacy HS256 projects. Leave empty to verify user JWTs via the project JWKS.
SUPABASE_JWT_SECRET=

# Sandbox only: PAYPAL_ENV=live is rejected at startup.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional with quick tunnels; polling is primary. Public route: /api/v1/webhooks/paypal
PAYPAL_WEBHOOK_ID=
PAYPAL_HTTP_TIMEOUT_SECONDS=8
PAYPAL_BRAND_NAME=ClawPay
PAYPAL_INLINE_BUDGET_SECONDS=10
RECONCILE_INTERVAL_SECONDS=30
# Do not raise until PayPal Request-Id retention and duplicate-invoice blocking are verified.
RECONCILE_REPLAY_WINDOW_SECONDS=900

GADGET_APPROVAL_PUBLIC_KEY_REGISTRY=

AGENTCORE_REGION=
# Multi-agent mode: ClawPay sends every PayPal call to the separate PayPal agent
# (app/paypal_agent, A2A over HTTP) instead of calling PayPal itself. Empty =
# direct mode. https://, or http:// to 127.0.0.1/localhost only. When set, the
# PayPal credentials live in the agent's environment, not ClawPay's.
PAYPAL_AGENT_ENDPOINT=
# Shared bearer between ClawPay and the PayPal agent (>= 32 chars). Required
# by the agent process, and by ClawPay when PAYPAL_AGENT_ENDPOINT is set.
PAYPAL_AGENT_TOKEN=
# Merchant agents. Empty = in-process mock agents (no network). To run one
# standalone: uv run uvicorn --factory app.merchant_agents.app:grocer_app --host 127.0.0.1 --port 8101
# then GROCER_AGENT_ENDPOINT=http://127.0.0.1:8101/a2a. Only https:// or
# http://127.0.0.1 / http://localhost are accepted.
GROCER_AGENT_ENDPOINT=
ELECTRONICS_AGENT_ENDPOINT=
# Channel3 marketplace merchant (real product catalog, https://channel3.ai).
# Set the API key to enable merchant_id "channel3"; ClawPay then runs the
# Channel3 agent in-process (no public route). Every search/quote spends Channel3
# credits. Offers are priced in DEFAULT_CURRENCY, so most catalogs need
# DEFAULT_CURRENCY=USD. ClawPay charges PayPal; it does not order from the retailer.
CHANNEL3_API_KEY=
# Optional: a standalone Channel3 agent (uvicorn --factory app.merchant_agents.channel3:channel3_app).
CHANNEL3_AGENT_ENDPOINT=
CHANNEL3_BASE_URL=https://api.trychannel3.com
# ISO 3166-1 alpha-2 country for offers.
CHANNEL3_COUNTRY=US
CHANNEL3_TIMEOUT_SECONDS=4.5
# Agent passports: owner-issued, signed, revocable grants for agent devices.
# 32 random bytes, base64url, signs grants and receipts (Ed25519). Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).rstrip(b'=').decode())"
# Empty = grants cannot be issued (existing grants are still enforced).
AGENT_PASSPORT_SIGNING_KEY=xwSRdldQ2ZlKNkaSTRReLoB5FP1N9EEtBTkSg3lW2Zg
# true = a device that was never given a grant cannot order. false = only granted devices are governed.
AGENT_PASSPORT_REQUIRED=false
MERCHANT_AGENT_TIMEOUT_SECONDS=8

# Admin token: device registration and admin revoke. At least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_TOKEN=

# ESP-Claw device integration.
# PUBLIC_BASE_URL: public HTTPS origin with a CA-signed cert (tunnel or host),
# e.g. https://xxxx.trycloudflare.com.
PUBLIC_BASE_URL=
MCP_ENABLED=false
# Demo-only fallback POST /mcp/<device_token>; leaks the token into the device
# LLM context and logs. Keep false once the bearer-token firmware patch is flashed.
MCP_PATH_TOKEN_ENABLED=false
# Comma-separated; any request with an Origin not listed gets 403. The device sends no Origin.
MCP_ALLOWED_ORIGINS=
MCP_TOOL_CALLS_PER_MINUTE=30
MCP_REQUESTS_PER_MINUTE=120
DEVICE_REQUESTS_PER_MINUTE=30
AUTH_FAILURES_PER_MINUTE=20
# How to find the client IP for IP rate limits: none (socket peer),
# cf-connecting-ip (cloudflared), x-forwarded-for-last (ngrok).
CLIENT_IP_HEADER=none
# false = only INTERNAL_SERVICE_TOKEN can register devices.
DEVICE_OWNER_REGISTRATION_ENABLED=false
# HMAC pepper for device/LLM tokens at rest. Required (>= 32 chars) when MCP_ENABLED=true.
# Generate like INTERNAL_SERVICE_TOKEN. Changing it invalidates every issued token.
DEVICE_TOKEN_PEPPER=

# Orders
QUOTE_TTL_SECONDS=300
CHALLENGE_TTL_SECONDS=120
ORDER_REQUIRE_PAYMENT_METHOD=true

# OpenAI-compatible LLM proxy for the device. Put only cpl_ in Web Console LLM Settings.
# Run one uvicorn worker: rate limits and KL-day token budgets are in-memory, reset on restart. The upstream key stays here,
# never on the device. Base URL without /chat/completions, e.g. https://api.openai.com/v1
LLM_PROXY_UPSTREAM_BASE_URL=
LLM_PROXY_UPSTREAM_API_KEY=
# Direct DeepSeek: set base URL to https://api.deepseek.com and model to deepseek-flash.
# DEEPSEEK_API_KEY is used when LLM_PROXY_UPSTREAM_API_KEY is empty; server-side only.
DEEPSEEK_API_KEY=
LLM_PROXY_MODEL=
LLM_PROXY_MAX_TOKENS=1024
LLM_PROXY_REQUESTS_PER_MINUTE=20
LLM_PROXY_DAILY_TOKEN_LIMIT=200000
LLM_PROXY_MAX_BODY_BYTES=262144
LLM_PROXY_TIMEOUT_SECONDS=110

# Fish Audio text-to-speech for watch replies (POST /api/v1/assistant/speech). Unset = 503 and the
# watch uses its built-in voice. The key stays on the server. Voice id = a Fish Audio voice model's
# reference_id (fish.audio > voice page); empty uses Fish's default voice. Free tier: s2.1-pro-free.
# The same key also powers microphone STT at /api/v1/assistant/transcriptions (transcribe-1-pro).
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=s2.1-pro
FISH_AUDIO_REQUESTS_PER_MINUTE=20
FISH_AUDIO_TIMEOUT_SECONDS=20

# Money is in MINOR units (sen for MYR): RM100 = 10000, RM500 = 50000.
PHONE_APPROVAL_THRESHOLD_MINOR=10000
DAILY_SPENDING_LIMIT_MINOR=50000
# MYR or USD only.
DEFAULT_CURRENCY=MYR
SPENDING_DAY_TIMEZONE=Asia/Kuala_Lumpur

# Optional live smoke uses shell-only CLAWPAY_LIVE_SMOKE=1 plus isolated
# CLAWPAY_SMOKE_PAYPAL_CLIENT_ID / CLAWPAY_SMOKE_PAYPAL_CLIENT_SECRET.
# Default tests skip it; it creates only an OAuth/setup token, never a charge.
